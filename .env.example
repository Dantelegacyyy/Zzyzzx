NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin: use Application Default Credentials in Codespaces/deployment.
FIREBASE_PROJECT_ID=your-project-id

# Firebase client configuration. These values identify the Firebase project;
# they are not privileged server secrets.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=replace-me

# Server-only Gemini secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Base64-encoded 32-byte AES key used only by the server token vault.
CANVAS_TOKEN_ENCRYPTION_KEY_B64=

# JSON array of institution provider records. Never expose this env var to Vite.
CANVAS_PROVIDERS_JSON=[]
AI_STUDIO_PREVIEW_EMBED=false
