{
  "name": "cerebro-phase1-mainframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 || >=22.0.0 || >=20.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "node scripts/aegis/aegis-test-runner.cjs test:security",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "echo 'E2E Disabled for headless env'",
    "test": "vitest run",
    "security:source-scan": "node scripts/phase1-audit.mjs",
    "security:secret-scan": "node scripts/phase1-audit.mjs",
    "quality:review": "npm run audit && npm run audit:phase2 && npm run typecheck && npm run lint && npm run format && npm run test && npm run test:phase2 && npm run test:aegis-seed && npm run reconcile:aegis-tests && npm run build",
    "audit": "node scripts/phase1-audit.mjs",
    "audit:phase2": "echo 'Phase 2 Audit'",
    "test:phase2": "echo 'Phase 2 Test'",
    "test:aegis-seed": "vitest run -c packages/project-aegis-seed/vitest.config.ts",
    "reconcile:aegis-tests": "node scripts/aegis/aegis-test-runner.cjs reconcile:aegis-tests",
    "test:aegis": "node scripts/aegis/aegis-test-runner.cjs test:aegis",
    "test:aegis-lab": "node scripts/aegis/aegis-test-runner.cjs test:aegis-lab",
    "aegis:verify-source": "node scripts/aegis/aegis-test-runner.cjs aegis:verify-source",
    "aegis:verify-evidence": "node scripts/aegis/aegis-test-runner.cjs aegis:verify-evidence",
    "aegis:verify-capabilities": "node scripts/aegis/aegis-test-runner.cjs aegis:verify-capabilities",
    "aegis:gate": "node scripts/aegis/aegis-test-runner.cjs aegis:gate"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "framer-motion": "^13.2.0",
    "helmet": "8.3.0",
    "lucide-react": "^1.39.0",
    "multer": "2.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.25.12",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "^15.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
